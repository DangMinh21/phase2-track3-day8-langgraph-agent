# OpenAI — dùng cho LLM classification trong classify_node
# Nếu không set, tự động fallback sang keyword heuristic (không crash)
OPENAI_API_KEY=sk-...
CLASSIFY_MODEL=gpt-4o-mini

# LangGraph HITL — set "true" để bật real interrupt() trong Streamlit UI
# Để trống hoặc "false" → mock approval (phù hợp cho CI / make run-scenarios)
LANGGRAPH_INTERRUPT=false

# Persistence backend: memory | sqlite | none
CHECKPOINTER=memory

# SQLite path (chỉ dùng khi CHECKPOINTER=sqlite)
DATABASE_URL=outputs/checkpoints.db

LOG_LEVEL=INFO
